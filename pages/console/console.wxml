<view class="page">

  <!-- 链路状态与统计 -->
  <view class="card">
    <view class="row between">
      <view class="title">链路</view>
      <view class="row">
        <view class="tag {{connected ? 'ok' : 'err'}}">{{connected ? '已连接' : '未连接'}}</view>
        <view class="tag {{loggedIn ? 'ok' : 'warn'}}" style="margin-left: 12rpx;">{{loggedIn ? '已登录' : '未登录'}}</view>
      </view>
    </view>

    <view class="divider"></view>

    <view class="kv">
      <text class="k">CMD 通知数</text>
      <text class="v mono">{{stats.notifyCount}} 条 / {{stats.notifyBytes}} B</text>
    </view>
    <view class="kv">
      <text class="k">通知分片长度</text>
      <text class="v mono">{{stats.fragments}} B</text>
    </view>
    <view class="kv">
      <text class="k">已重组对象</text>
      <text class="v mono">{{stats.objects}}</text>
    </view>
    <view class="kv">
      <text class="k">GATT 写片数</text>
      <text class="v mono">{{stats.chunks}}（20B/片）</text>
    </view>
    <view class="kv">
      <text class="k">DATA 通知</text>
      <text class="v mono">{{stats.dataFrames}} 帧</text>
    </view>

    <button wx:if="{{!loggedIn}}" class="btn ghost block" bindtap="onRelogin">用内存凭据重新登录</button>
  </view>

  <!-- 原始命令 -->
  <view class="card">
    <view class="title">CMD 原始命令</view>
    <view class="hint">自动补 id / version / token；超过 512B 会被拒绝</view>

    <view class="row wrap" style="margin-top: 16rpx;">
      <view
        wx:for="{{presets}}"
        wx:key="label"
        class="tag blue"
        style="margin: 0 12rpx 12rpx 0;"
        bindtap="onPickPreset"
        data-index="{{index}}"
      >{{item.label}}</view>
    </view>

    <textarea
      class="textarea"
      value="{{input}}"
      bindinput="onInput"
      auto-height="{{false}}"
      maxlength="-1"
      placeholder="输入 v1 命令 JSON（可先点上面的预设）"
    ></textarea>

    <button class="btn primary block" bindtap="onSend" loading="{{sending}}" disabled="{{sending}}">发送</button>
  </view>

  <!-- DATA 通道 -->
  <view class="card">
    <view class="title">DATA 通道回环</view>
    <view class="hint">
      DATA 是原始字节管道：无帧头、序号、ACK、重传。GATT 写成功 ≠ 端到端送达。
    </view>

    <view class="row wrap" style="margin-top: 16rpx;">
      <button class="btn sm ghost" style="margin-right: 12rpx;" data-enabled="{{true}}" bindtap="onLoopback">开启回环</button>
      <button class="btn sm ghost" data-enabled="{{false}}" bindtap="onLoopback">关闭回环</button>
    </view>

    <view class="row wrap" style="margin-top: 16rpx;">
      <button class="btn sm primary" style="margin-right: 12rpx;" data-size="20" bindtap="onDataTest">20B</button>
      <button class="btn sm primary" style="margin-right: 12rpx;" data-size="200" bindtap="onDataTest">200B</button>
      <button class="btn sm primary" data-size="600" bindtap="onDataTest">600B</button>
    </view>

    <view wx:if="{{dataResult}}" class="{{dataResultKind === 'err' ? 'err-box' : 'warn-box'}}" style="{{dataResultKind === 'ok' ? 'background:#e8f7ee;color:#0a7040;' : ''}}">
      {{dataResult}}
    </view>
  </view>

  <!-- 日志 -->
  <view class="card">
    <view class="row between">
      <view class="title">链路日志</view>
      <view class="row">
        <text class="link" bindtap="onCopyLog">复制</text>
        <text class="link" style="margin-left: 24rpx;" bindtap="onClearLog">清空</text>
      </view>
    </view>
    <scroll-view class="log" style="height: 460rpx;" scroll-y scroll-into-view="{{scrollTo}}" scroll-with-animation>
      <view wx:for="{{logs}}" wx:key="id" class="log-line {{item.kind}}">{{item.t}}  {{item.text}}</view>
      <view wx:if="{{logs.length === 0}}" class="hint">暂无日志</view>
      <view id="log-bottom" style="height: 4rpx;"></view>
    </scroll-view>
  </view>

</view>

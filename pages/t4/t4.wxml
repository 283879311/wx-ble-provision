<view class="page">

  <!-- 链路状态 -->
  <view class="card">
    <view class="row between">
      <view style="flex: 1; min-width: 0;">
        <view class="title">T4 · 功能自检</view>
        <view class="hint">{{ready ? ((deviceName || '设备') + ' · 会话 #' + sessionId) : '断开状态'}} · 写分片 20B 固定</view>
      </view>
      <view class="tag {{loggedIn ? 'ok' : (ready ? 'warn' : 'blue')}}">
        {{loggedIn ? '已登录' : (ready ? '未登录' : '未连接')}}
      </view>
    </view>

    <view wx:if="{{linkText}}" class="hint" style="margin-top: 10rpx;">{{linkText}}</view>

    <view class="row" style="margin-top: 16rpx;">
      <button
        class="btn sm ghost"
        bindtap="onAutoLink"
        loading="{{linking}}"
        disabled="{{busy}}"
      >{{ready ? '重连登录' : '仅连接并登录'}}</button>
      <button
        wx:if="{{!ready}}"
        class="btn sm ghost"
        style="margin-left: 12rpx;"
        bindtap="onResetAdapter"
        loading="{{linking}}"
        disabled="{{busy}}"
      >重启蓝牙恢复广播</button>
      <button class="btn sm ghost" style="margin-left: 12rpx;" bindtap="onNetDiag" disabled="{{busy}}">网络诊断</button>
      <button class="btn sm ghost" style="margin-left: 12rpx;" bindtap="goBack" disabled="{{busy}}">返回</button>
    </view>
  </view>

  <!-- 运行控制 -->
  <view class="card">
    <view class="row between">
      <view style="flex: 1; min-width: 0;">
        <view class="hint">P0 项含断开态取证、配网、救援；NOT_RUN / INCOMPLETE / BLOCKED 都不计入 PASS</view>
      </view>
      <view class="tag {{summary.fail || summary.blocked ? 'err' : (summary.pass ? 'ok' : 'blue')}}">
        {{summary.pass}}P · {{summary.expected}}E · {{summary.fail}}F · {{summary.not_run}}N · {{summary.incomplete}}I · {{summary.blocked}}B
      </view>
    </view>

    <view class="row" style="margin-top: 16rpx;">
      <button class="btn primary block" bindtap="onRunAll" loading="{{running}}" disabled="{{busy}}">运行全部</button>
    </view>

    <view
      wx:if="{{verdict}}"
      class="{{verdictKind === 'fail' ? 'err-box' : (verdictKind === 'ok' ? 'ok-box' : 'warn-box')}}"
      style="margin-top: 16rpx;"
    >
      <text>{{verdict}}</text>
      <block wx:if="{{!ready}}">
        <view class="hint" style="margin-top: 6rpx;">当前断开：第 1 项可立即取证，其余项会自动扫描并连接。</view>
      </block>
      <block wx:else>
        <view class="hint" style="margin-top: 6rpx;">链路已就绪，可直接运行。</view>
      </block>
    </view>
  </view>

  <!-- 检查项 -->
  <view class="card" wx:for="{{items}}" wx:key="id">
    <view class="row between">
      <view style="flex: 1; min-width: 0;">
        <view class="title sm">
          {{item.no}}. {{item.name}}<text wx:if="{{item.tier === 'p1'}}" class="tag warn" style="margin-left: 8rpx;">P1</text><text wx:else class="tag err" style="margin-left: 8rpx;">P0</text>
        </view>
        <view class="hint">{{item.desc}}</view>
      </view>
      <view
        class="tag {{item.state === 'pass' ? 'ok' : (item.state === 'fail' || item.state === 'blocked' ? 'err' : (item.state === 'expected' || item.state === 'incomplete' ? 'warn' : (item.state === 'running' ? 'blue' : '')))}}"
      >{{item.statusText}}</view>
    </view>

    <view wx:if="{{item.detail}}" class="pre mono" style="margin-top: 8rpx;">{{item.detail}}</view>

    <view class="row" style="margin-top: 10rpx;">
      <text wx:if="{{item.ms}}" class="hint">{{item.ms}}ms</text>
      <button
        class="btn sm ghost act"
        style="margin-left: auto;"
        bindtap="onRunOne"
        data-index="{{index}}"
        disabled="{{busy}}"
      >{{item.manual ? '取证' : '单项运行'}}</button>
    </view>
  </view>

  <!-- 报告 -->
  <view class="card" wx:if="{{report}}">
    <view class="row between">
      <view class="title sm">T4 报告</view>
      <button class="btn sm ghost act" bindtap="onCopyReport" disabled="{{busy}}">复制</button>
    </view>
    <view class="pre mono" style="margin-top: 12rpx;">{{report}}</view>
  </view>

</view>

/* UART 配置页：两列栅格（引脚/串口参数/收发格式共用） */

.uart-grid {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-top: 16rpx;
}

.uart-cell {
  width: 48%;
  min-width: 0;
  box-sizing: border-box;
}

.uart-cell .input {
  margin-top: 6rpx;
}

.uart-gpio {
  margin-top: 6rpx;
  padding: 18rpx 0;
  text-align: center;
  font-size: 30rpx;
  color: #2b313b;
  background: #f3f5f9;
  border-radius: 12rpx;
  border: 1rpx solid #e6e9f0;
}

/* 接收控制台：只做人工观察，长内容内部滚动 */
.uart-console {
  height: 320rpx;
  margin-top: 8rpx;
  padding: 16rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #2b313b;
  background: #f7f8fb;
  border: 1rpx solid #e6e9f0;
  border-radius: 12rpx;
  box-sizing: border-box;
  white-space: pre-wrap;
  word-break: break-all;
  overflow: hidden;
}

.uart-send-row {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.uart-send {
  /* .input 默认 width:100%，在 flex 行里会挤掉按钮，这里显式改回自适应 */
  width: auto;
  flex: 1;
  min-width: 0;
  margin-right: 12rpx;
}

/* 状态行：加载/已保存/错误 */
.uart-status {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8a8f99;
  line-height: 1.5;
}

.uart-status.ok {
  color: #1a7f37;
}

.uart-status.err {
  color: #d93b3b;
}

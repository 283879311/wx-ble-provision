/* SSID 口令弹窗（点扫描列表项弹出） */
.pw-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 20, 30, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.pw-modal {
  width: 100%;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  box-sizing: border-box;
}

/* 口令输入行：输入框 + 小眼睛可见切换 */
.pw-row {
  display: flex;
  align-items: center;
}

.pw-row .pw-input {
  flex: 1;
  min-width: 0;
}

.pw-eye {
  flex: 0 0 auto;
  width: 64rpx;
  height: 64rpx;
  margin-left: 12rpx;
  background: url("data:image/svg+xml;base64,") no-repeat center / contain;
  opacity: 0.75;
}

.pw-eye.on {
  background-image: url("data:image/svg+xml;base64,");
  opacity: 1;
}

/* cfg_state=fallback 横幅（固件 ≥1.3）：救援网络提示 */
.cfg-warn {
  margin: 12rpx 0;
  padding: 16rpx 20rpx;
  border: 1rpx solid #e6b800;
  border-radius: 12rpx;
  background: #fff8e0;
}
.cfg-warn-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #8a6d00;
}
.cfg-warn-hint {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8a6d00;
  opacity: 0.85;
}

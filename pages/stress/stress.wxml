<view class="page">

  <!-- 链路 -->
  <view class="card">
    <view class="row between">
      <view style="flex: 1; min-width: 0;">
        <view class="title">传输压测</view>
        <view class="hint">{{ready ? ((deviceName || '设备') + ' · 会话 #' + sessionId) : '断开状态'}} · DATA 通道 20B 分片</view>
      </view>
      <view class="tag {{loggedIn ? 'ok' : (ready ? 'warn' : 'blue')}}">
        {{loggedIn ? '已登录' : (ready ? '未登录' : '未连接')}}
      </view>
    </view>
    <view wx:if="{{linkText}}" class="hint" style="margin-top: 10rpx;">{{linkText}}</view>
    <view class="row" style="margin-top: 16rpx;">
      <button class="btn sm ghost" bindtap="onAutoLink" loading="{{linking}}" disabled="{{busy}}">{{ready ? '重连登录' : '仅连接并登录'}}</button>
      <button wx:if="{{!ready}}" class="btn sm ghost" style="margin-left: 12rpx;" bindtap="onResetAdapter" loading="{{linking}}" disabled="{{busy}}">重启蓝牙恢复广播</button>
      <button class="btn sm ghost" style="margin-left: 12rpx;" bindtap="goBack" disabled="{{busy}}">返回</button>
    </view>
  </view>

  <!-- 模式 -->
  <view class="card">
    <view class="title sm">测试模式</view>
    <view class="seg" style="margin-top: 10rpx;">
      <view
        wx:for="{{modeChoices}}"
        wx:key="v"
        class="seg-item {{mode === item.v ? 'on' : ''}}"
        bindtap="onPickMode"
        data-v="{{item.v}}"
      >{{item.label}}</view>
    </view>
    <view class="hint" style="margin-top: 10rpx;" wx:if="{{mode === 'listen'}}">L0：本机不发，只解析对端灌下来的帧，测下行到达率。</view>
    <view class="hint" style="margin-top: 10rpx;" wx:elif="{{mode === 'echo'}}">L1：本机发帧，对端原样回显，测完整性 + 帧级 RTT。</view>
    <view class="hint" style="margin-top: 10rpx;" wx:else>L2：本机按目标速率主动灌流，测上行吞吐与提交量。</view>

    <view class="title sm" style="margin-top: 16rpx;">对端</view>
    <view class="seg" style="margin-top: 10rpx;">
      <view
        wx:for="{{peerChoices}}"
        wx:key="v"
        class="seg-item {{peer === item.v ? 'on' : ''}}"
        bindtap="onPickPeer"
        data-v="{{item.v}}"
      >{{item.label}}</view>
    </view>
    <view class="hint" style="margin-top: 10rpx;">
      设备回环 = 纯 BLE 链路（不经 UART）；PC 回显 = BLE + UART1 全通路；不改 = 沿用设备当前设置。
    </view>
  </view>

  <!-- 参数 -->
  <view class="card">
    <view class="title sm">参数</view>

    <view class="hint" style="margin-top: 12rpx;">帧长（含 9B 开销）</view>
    <view class="seg" style="margin-top: 8rpx;">
      <view
        wx:for="{{frameChoices}}"
        wx:key="*this"
        class="seg-item {{frameLen === item ? 'on' : ''}}"
        bindtap="onPickFrame"
        data-v="{{item}}"
      >{{item}}</view>
    </view>

    <view class="hint" style="margin-top: 12rpx;">帧数</view>
    <view class="seg" style="margin-top: 8rpx;">
      <view
        wx:for="{{countChoices}}"
        wx:key="*this"
        class="seg-item {{frames === item ? 'on' : ''}}"
        bindtap="onPickCount"
        data-v="{{item}}"
      >{{item}}</view>
    </view>

    <view class="hint" style="margin-top: 12rpx;">目标速率</view>
    <view class="seg" style="margin-top: 8rpx;">
      <view
        wx:for="{{rateChoices}}"
        wx:key="*this"
        class="seg-item {{rate === item ? 'on' : ''}}"
        bindtap="onPickRate"
        data-v="{{item}}"
      >{{item === 0 ? '不限' : item + ' B/s'}}</view>
    </view>

    <view class="hint" style="margin-top: 12rpx;">{{estText}}</view>
  </view>

  <!-- 对端命令 -->
  <view class="card">
    <view class="row between">
      <view class="title sm">对端准备</view>
      <view class="tag blue">{{runIdText}}</view>
    </view>
    <view class="hint" style="margin-top: 8rpx;">runId 必须两端一致，否则 START/END 会被当作上一轮的串轮帧丢掉。</view>
    <view class="pre mono" style="margin-top: 10rpx;">{{cmdText}}</view>
    <view class="row" style="margin-top: 12rpx;">
      <button class="btn sm ghost act" bindtap="onCopyCmd">复制命令</button>
      <button class="btn sm ghost act" style="margin-left: 12rpx;" bindtap="onNewRunId" disabled="{{running}}">换 runId</button>
    </view>
  </view>

  <!-- 起停 -->
  <view class="card">
    <view class="row">
      <button wx:if="{{!running}}" class="btn primary block" bindtap="onStart" disabled="{{busy}}">开始压测</button>
      <button wx:else class="btn danger block" bindtap="onAbort">中止</button>
    </view>
    <view class="hint" style="margin-top: 10rpx;">{{progressText}}</view>
  </view>

  <!-- 实时 -->
  <view class="card" wx:if="{{running || progress.sent > 0 || progress.received > 0}}">
    <view class="row between">
      <view class="title sm">实时</view>
      <view class="tag {{progress.crcErrors ? 'err' : (progress.seqGaps ? 'warn' : 'blue')}}">{{progress.settle}}</view>
    </view>
    <view class="row wrap" style="margin-top: 12rpx;">
      <view class="hint" style="margin-right: 20rpx;">发 {{progress.sent}}</view>
      <view class="hint" style="margin-right: 20rpx;">收 {{progress.received}}</view>
      <view class="hint" style="margin-right: 20rpx;">缺 {{progress.seqGaps}}</view>
      <view class="hint" style="margin-right: 20rpx;">重 {{progress.duplicates}}</view>
      <view class="hint" style="margin-right: 20rpx;">CRC {{progress.crcErrors}}</view>
      <view class="hint">{{progress.elapsedMs}}ms</view>
    </view>
    <view wx:if="{{logText}}" class="pre mono" style="margin-top: 12rpx;">{{logText}}</view>
  </view>

  <!-- 报告 -->
  <view class="card" wx:if="{{reportText}}">
    <view class="row between">
      <view class="title sm">报告</view>
      <view class="tag {{verdictKind === 'ok' ? 'ok' : (verdictKind === 'fail' ? 'err' : 'warn')}}">{{verdict}}</view>
    </view>
    <view class="pre mono" style="margin-top: 12rpx;">{{reportText}}</view>
    <view class="row" style="margin-top: 12rpx;">
      <button class="btn sm ghost act" bindtap="onCopyReport">复制文本</button>
      <button class="btn sm ghost act" style="margin-left: 12rpx;" bindtap="onCopyJson">复制 JSON</button>
    </view>
  </view>

</view>

.pad { padding: 24rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.h1 { font-size: 32rpx; font-weight: 600; margin-bottom: 16rpx; }
.row { display: flex; align-items: center; margin: 10rpx 0; }
.row .label { width: 180rpx; font-size: 26rpx; color: #555; }
.row input { flex: 1; border-bottom: 1rpx solid #e5e7eb; font-size: 26rpx; padding: 6rpx 4rpx; }
.eye { flex: none; font-size: 24rpx; color: #1a6dff; padding-left: 16rpx; }
/* 明文核对用等宽字体：l/I/1、O/0 在比例字体里看着一样，等宽 + 字距能肉眼分辨 */
.pwdtext { font-family: Menlo, Consolas, monospace; letter-spacing: 2rpx; }
.pwdmeta { font-size: 22rpx; color: #888; margin: -2rpx 0 12rpx 180rpx; word-break: break-all; }
.pwdwarn { color: #dc2626; margin-left: 8rpx; }
.chip { display: inline-block; padding: 10rpx 20rpx; border-radius: 999rpx; background: #eef1f6; color: #444; font-size: 24rpx; margin: 8rpx 12rpx 8rpx 0; border: 2rpx solid #eef1f6; }
.chip.on { background: #e6f0ff; color: #1a6dff; border-color: #1a6dff; }
.btn { margin: 20rpx 0; background: #1a6dff; color: #fff; border-radius: 12rpx; font-size: 30rpx; }
.btn[disabled] { background: #9db8e8; }
.log { background: #0f172a; color: #d1e3ff; border-radius: 12rpx; padding: 16rpx; font-size: 22rpx; max-height: 420rpx; overflow-y: scroll; font-family: monospace; white-space: pre-wrap; word-break: break-all; }
.res { padding: 12rpx 0; border-bottom: 1rpx solid #f0f1f4; font-size: 26rpx; }
.res .tag { display: inline-block; width: 84rpx; font-weight: 700; }
.res .tag.ok { color: #16a34a; }
.res .tag.bad { color: #dc2626; }
.res .detail { color: #777; font-size: 22rpx; margin-top: 4rpx; word-break: break-all; }
.sum { font-size: 30rpx; font-weight: 600; }
.scroll { max-height: 520rpx; }
